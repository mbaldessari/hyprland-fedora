+
+// --- Clipboard implementation ---
+
+std::shared_ptr<CInputCapturePortal::SSession> CInputCapturePortal::findClipboardSession() {
+    for (auto& [key, session] : m_sessions) {
+        if (!session->dead && session->clipboardEnabled)
+            return session;
+    }
+    return nullptr;
+}
+
+void CInputCapturePortal::initDataControl() {
+    auto& wl = g_pPortalManager->m_sWaylandConnection;
+    if (!wl.dataControlMgr || !wl.seat) {
+        Debug::log(WARN, "[clipboard] wlr-data-control or wl_seat not available, clipboard will not work");
+        return;
+    }
+
+    m_dataDevice = makeShared<CCZwlrDataControlDeviceV1>(wl.dataControlMgr->sendGetDataDevice(wl.seat->resource()));
+
+    m_dataDevice->setDataOffer([this](CCZwlrDataControlDeviceV1*, wl_proxy* offerProxy) {
+        m_currentOffer = makeShared<CCZwlrDataControlOfferV1>(offerProxy);
+        m_currentOfferMimeTypes.clear();
+
+        m_currentOffer->setOffer([this](CCZwlrDataControlOfferV1*, const char* mimeType) {
+            if (mimeType)
+                m_currentOfferMimeTypes.emplace_back(mimeType);
+        });
+    });
+
+    m_dataDevice->setSelection([this](CCZwlrDataControlDeviceV1*, wl_proxy* offerProxy) {
+        if (!offerProxy) {
+            m_currentOffer.reset();
+            m_currentOfferMimeTypes.clear();
+            return;
+        }
+        onSelectionChanged(m_currentOffer);
+    });
+
+    m_dataDevice->setPrimarySelection([](CCZwlrDataControlDeviceV1*, wl_proxy*) {
+        // We only handle the regular clipboard, not primary selection
+    });
+
+    m_dataDevice->setFinished([this](CCZwlrDataControlDeviceV1*) {
+        Debug::log(WARN, "[clipboard] data control device finished, clipboard will stop working");
+        m_dataDevice.reset();
+    });
+
+    Debug::log(LOG, "[clipboard] data control device initialized");
+}
+
+void CInputCapturePortal::onSelectionChanged(SP<CCZwlrDataControlOfferV1> offer) {
+    auto session = findClipboardSession();
+    if (!session)
+        return;
+
+    Debug::log(LOG, "[clipboard] local selection changed, {} mime types", m_currentOfferMimeTypes.size());
+
+    std::vector<std::string> mimes = m_currentOfferMimeTypes;
+
+    std::unordered_map<std::string, sdbus::Variant> options;
+    options["mime_types"]       = sdbus::Variant{mimes};
+    options["session_is_owner"] = sdbus::Variant{false};
+
+    m_pObject->emitSignal("SelectionOwnerChanged").onInterface(CLIPBOARD_INTERFACE_NAME).withArguments(session->sessionHandle, options);
+}
+
+void CInputCapturePortal::onRequestClipboard(sdbus::ObjectPath sessionHandle, std::unordered_map<std::string, sdbus::Variant> options) {
+    Debug::log(LOG, "[clipboard] RequestClipboard for {}", sessionHandle.c_str());
+
+    if (!m_sessions.contains(sessionHandle)) {
+        Debug::log(WARN, "[clipboard] RequestClipboard: unknown session {}", sessionHandle.c_str());
+        return;
+    }
+
+    auto& session = m_sessions[sessionHandle];
+    if (session->state != SESSION_STATE_INIT) {
+        Debug::log(WARN, "[clipboard] RequestClipboard called after session started");
+        return;
+    }
+
+    session->clipboardRequested = true;
+}
+
+void CInputCapturePortal::onSetSelection(sdbus::ObjectPath sessionHandle, std::unordered_map<std::string, sdbus::Variant> options) {
+    Debug::log(LOG, "[clipboard] SetSelection for {}", sessionHandle.c_str());
+
+    if (!m_sessions.contains(sessionHandle)) {
+        Debug::log(WARN, "[clipboard] SetSelection: unknown session {}", sessionHandle.c_str());
+        return;
+    }
+
+    auto& session = m_sessions[sessionHandle];
+    if (!session->clipboardEnabled) {
+        Debug::log(WARN, "[clipboard] SetSelection: clipboard not enabled");
+        return;
+    }
+
+    auto& wl = g_pPortalManager->m_sWaylandConnection;
+    if (!wl.dataControlMgr || !m_dataDevice) {
+        Debug::log(WARN, "[clipboard] SetSelection: data control not available");
+        return;
+    }
+
+    std::vector<std::string> mimeTypes;
+    if (options.contains("mime_types")) {
+        try {
+            mimeTypes = options["mime_types"].get<std::vector<std::string>>();
+        } catch (std::exception& e) {
+            Debug::log(WARN, "[clipboard] SetSelection: invalid mime_types: {}", e.what());
+            return;
+        }
+    }
+
+    Debug::log(LOG, "[clipboard] SetSelection: {} mime types", mimeTypes.size());
+
+    session->dataSource = makeShared<CCZwlrDataControlSourceV1>(wl.dataControlMgr->sendCreateDataSource());
+    session->remoteMimeTypes = mimeTypes;
+
+    for (const auto& mime : mimeTypes) {
+        Debug::log(LOG, "[clipboard]  | offering: {}", mime);
+        session->dataSource->sendOffer(mime.c_str());
+    }
+
+    session->dataSource->setSend([this, sessionHandle](CCZwlrDataControlSourceV1*, const char* mimeType, int32_t fd) {
+        if (!m_sessions.contains(sessionHandle)) {
+            close(fd);
+            return;
+        }
+
+        auto& session = m_sessions[sessionHandle];
+        uint32_t serial = session->nextSerial++;
+        session->pendingTransfers[serial] = {fd, mimeType ? mimeType : ""};
+
+        Debug::log(LOG, "[clipboard] compositor requests data, mime: {}, serial: {}", mimeType ? mimeType : "(null)", serial);
+        m_pObject->emitSignal("SelectionTransfer").onInterface(CLIPBOARD_INTERFACE_NAME).withArguments(session->sessionHandle, std::string(mimeType ? mimeType : ""), serial);
+    });
+
+    session->dataSource->setCancelled([this, sessionHandle](CCZwlrDataControlSourceV1*) {
+        Debug::log(LOG, "[clipboard] data source cancelled");
+        if (m_sessions.contains(sessionHandle))
+            m_sessions[sessionHandle]->dataSource.reset();
+    });
+
+    m_dataDevice->sendSetSelection(session->dataSource.get());
+    wl_display_flush(g_pPortalManager->m_sWaylandConnection.display);
+}
+
+sdbus::UnixFd CInputCapturePortal::onSelectionWrite(sdbus::ObjectPath sessionHandle, uint32_t serial) {
+    Debug::log(LOG, "[clipboard] SelectionWrite for {}, serial {}", sessionHandle.c_str(), serial);
+
+    if (!m_sessions.contains(sessionHandle))
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.portal.Error.Failed"}, "Unknown session"};
+
+    auto& session = m_sessions[sessionHandle];
+    if (!session->clipboardEnabled)
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.DBus.Error.AccessDenied"}, "Clipboard not enabled"};
+
+    auto it = session->pendingTransfers.find(serial);
+    if (it == session->pendingTransfers.end())
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.portal.Error.Failed"}, "Unknown serial"};
+
+    // The app will write data to the write end; we create a pipe and spawn a
+    // thread to forward data from the read end to the compositor fd.
+    int pipeFds[2];
+    if (pipe(pipeFds) < 0)
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.portal.Error.Failed"}, "pipe() failed"};
+
+    int readEnd  = pipeFds[0];
+    int writeEnd = pipeFds[1];
+    int compFd   = it->second.compositorFd;
+
+    // Detach the compositor fd from the pending map — it's now owned by the forwarding thread
+    it->second.compositorFd = -1;
+
+    std::thread([readEnd, compFd]() {
+        char buf[4096];
+        ssize_t n;
+        while ((n = read(readEnd, buf, sizeof(buf))) > 0) {
+            ssize_t written = 0;
+            while (written < n) {
+                ssize_t w = write(compFd, buf + written, n - written);
+                if (w <= 0)
+                    break;
+                written += w;
+            }
+        }
+        close(readEnd);
+        close(compFd);
+    }).detach();
+
+    return sdbus::UnixFd{writeEnd};
+}
+
+void CInputCapturePortal::onSelectionWriteDone(sdbus::ObjectPath sessionHandle, uint32_t serial, bool success) {
+    Debug::log(LOG, "[clipboard] SelectionWriteDone for {}, serial {}, success {}", sessionHandle.c_str(), serial, success);
+
+    if (!m_sessions.contains(sessionHandle))
+        return;
+
+    auto& session = m_sessions[sessionHandle];
+    auto  it      = session->pendingTransfers.find(serial);
+    if (it != session->pendingTransfers.end()) {
+        if (it->second.compositorFd >= 0)
+            close(it->second.compositorFd);
+        session->pendingTransfers.erase(it);
+    }
+}
+
+sdbus::UnixFd CInputCapturePortal::onSelectionRead(sdbus::ObjectPath sessionHandle, std::string mimeType) {
+    Debug::log(LOG, "[clipboard] SelectionRead for {}, mime: {}", sessionHandle.c_str(), mimeType);
+
+    if (!m_sessions.contains(sessionHandle))
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.portal.Error.Failed"}, "Unknown session"};
+
+    auto& session = m_sessions[sessionHandle];
+    if (!session->clipboardEnabled)
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.DBus.Error.AccessDenied"}, "Clipboard not enabled"};
+
+    if (!m_currentOffer)
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.portal.Error.Failed"}, "No clipboard data available"};
+
+    int pipeFds[2];
+    if (pipe(pipeFds) < 0)
+        throw sdbus::Error{sdbus::Error::Name{"org.freedesktop.portal.Error.Failed"}, "pipe() failed"};
+
+    int readEnd  = pipeFds[0];
+    int writeEnd = pipeFds[1];
+
+    m_currentOffer->sendReceive(mimeType.c_str(), writeEnd);
+    close(writeEnd);
+    wl_display_flush(g_pPortalManager->m_sWaylandConnection.display);
+
+    return sdbus::UnixFd{readEnd};
+}
